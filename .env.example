# Local SQLite. Production uses a libsql:// Turso URL plus TURSO_AUTH_TOKEN.
TURSO_DATABASE_URL=file:./data/local.db
TURSO_AUTH_TOKEN=

# How long the shared /result limiter waits for Turso before this instance counts in memory.
# Milliseconds. Default 1000. Values outside 50–2500 are ignored.
# RESULT_SHARED_LIMIT_MS=1000

# Canonical origin. Production is the apex domain.
NEXT_PUBLIC_SITE_URL=https://bestbotfor.com

# Optional. Not the click-log salt. A value of at least 16 characters can still be the HKDF source for rate-limit and click hashes when RATE_LIMIT_HMAC_SECRET is unset or shorter than 16 characters.
IP_HASH_SALT=

# HMAC key for rate-limit bucket ids and click-log IP hashes.
# Production (VERCEL_ENV=production) requires this and it must be at least 32 bytes.
# Elsewhere, a value shorter than 16 characters is ignored. When unset or too short, HKDF-SHA256 derives a 32-byte key from another server secret of at least 16 characters, and a warning is logged. The value is never logged.
# Click-log IP hashes use an HKDF-SHA256 subkey, info bestbotfor/click-ip/v1.
# Setting or rotating it starts new windows and new click hashes. In-flight counters are left behind.
RATE_LIMIT_HMAC_SECRET=

# Clerk. Leave blank to run the public site without accounts.
# The signups admin reuses CLERK_SECRET_KEY for read-only user lists. Blank means that source is unavailable.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Comma-separated Clerk user ids allowed into /admin, together with publicMetadata.role = admin.
# Server-only. Leave blank. Do not use a NEXT_PUBLIC_ name.
ADMIN_CLERK_USER_IDS=

# Stripe test mode only. Live secret keys are refused unless VERCEL_ENV is
# exactly production and STRIPE_ALLOW_LIVE is the exact value true. Neither
# value is trimmed. That flag ships false. Going live needs Mark's written approval.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Hosted Checkout does not put a publishable key in the browser. Leave this blank.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Default off. Do not set this to true in a committed env file.
STRIPE_ALLOW_LIVE=false
# One-time sponsor price ids from `npm run stripe:setup-test`.
# Approved list prices in src/lib/sponsor-offerings.ts:
# featured /best/[task] slot $99 per week (9900), $299 per month (29900),
# newsletter $49 per issue (4900). No Stripe recurring interval.
# The sponsor page and Checkout say “One-time payment, no auto-renewal.”
# The product name and card statement suffix are BestBotFor.
# Checkout uses these ids only. It does not accept a price from the browser.
STRIPE_PRICE_PLACEMENT_WEEKLY=
STRIPE_PRICE_PLACEMENT_MONTHLY=
STRIPE_PRICE_NEWSLETTER_SLOT=

# Optional Beehiiv. When unset, newsletter emails are stored locally.
# The signups admin reuses these. A blank value shows Beehiiv as unavailable there.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Optional Google Analytics 4 measurement ID, for example G-XXXX.
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# User ratings. Server-only. The exact value "on" enables the feature only when
# VERCEL_ENV is exactly preview, development, or test. An unset or unknown
# VERCEL_ENV is off. NODE_ENV is not consulted. Production stays off until
# USER_RATINGS_PRODUCTION_LAUNCH in src/lib/review-flags.ts is true.
# Leave this blank. Do not use a NEXT_PUBLIC_ name.
USER_RATINGS=

# Sponsor admin queue. Server-only. Independent of USER_RATINGS.
# The exact value "on" enables /admin/sponsors only when VERCEL_ENV is exactly
# preview, development, or test. An unset, empty, or any other value is off.
# An unset or unknown VERCEL_ENV is off. NODE_ENV is not consulted.
# Production stays off until ADMIN_SPONSORS_PRODUCTION_LAUNCH in
# src/lib/review-flags.ts is true. That waits for the A18 real Clerk admin test.
# /admin/mfa-required is available when this flag or USER_RATINGS is on.
# Leave this blank. Do not use a NEXT_PUBLIC_ name.
ADMIN_SPONSORS=

# Review IP HMAC. Required when VERCEL_ENV=production and when USER_RATINGS=on.
# At least 32 bytes. No fallback. Must differ from RATE_LIMIT_HMAC_SECRET.
# KEY_ID is required with the secret. Format: k followed by 1-9999, with no leading zero (^k[1-9][0-9]{0,3}$).
# Leading or trailing whitespace is refused. The value is not trimmed.
REVIEW_IP_HMAC_SECRET=
REVIEW_IP_HMAC_KEY_ID=
# Optional previous key, used while a rotation is verified. If set, at least 32 bytes.
# KEY_ID_PREVIOUS is then required, in the same format, and different from REVIEW_IP_HMAC_KEY_ID.
# A previous id without a previous secret is refused.
REVIEW_IP_HMAC_SECRET_PREVIOUS=
REVIEW_IP_HMAC_KEY_ID_PREVIOUS=
# Review per-user rate-limit key. Server-only, at least 32 characters. The Clerk user id
# is stored in rate_limits only as HMAC-SHA256 under this secret. Unset or short while
# user ratings are on: submit, edit and delete fail closed with 'unavailable'.
REVIEW_USER_LIMIT_SECRET=

# Data retention cron. Server-only. The exact value "on" enables the job only when
# VERCEL_ENV is exactly preview, development, or test. An unset or unknown
# VERCEL_ENV is off. NODE_ENV is not consulted. Production stays off until
# DATA_RETENTION_PRODUCTION_LAUNCH in src/lib/retention-flags.ts is true.
# Leave this blank. Do not use a NEXT_PUBLIC_ name.
DATA_RETENTION_PURGE=

# Dry-run is the default. The exact value "off" is required before the cron writes.
# Anything else, including unset, counts matching rows and writes nothing.
DATA_RETENTION_DRY_RUN=

# Vercel Cron sends Authorization: Bearer <this value>. At least 32 characters.
# A missing or shorter value fails closed. The value is not trimmed.
# Setting it does not enable writes. Leave blank locally. Never log it.
CRON_SECRET=

# E2E only. The build fails when this is 1 and VERCEL=1 or VERCEL_ENV=production.
# A local next build sets NODE_ENV=production and may still set this to 1.
# BBF_E2E_HOOKS=

# Member deal codes: STRIPE_PRICE_MEMBER_ANNUAL / STRIPE_PRICE_MEMBER_MONTHLY (from the pricing PR) count as membership.
# Optional extra comma-separated price IDs here. All unset = nobody is a member; everyone sees the locked teaser.
DEALS_MEMBER_PRICE_IDS=
# Membership pricing (/pricing). Both prices unset = /pricing shows "coming soon" and sells nothing.
# These price IDs also count as an active membership for the /deals gate.
STRIPE_PRICE_MEMBER_MONTHLY=
STRIPE_PRICE_MEMBER_ANNUAL=
# Founding coupon: $10 off once (= $19 first year on annual), max 100 redemptions. Annual only.
STRIPE_COUPON_FOUNDING=

# Signups admin at /admin/signups. Not linked from the public site.
# All three auth values must be set or the route 404s. Generate them with
# npm run setup-signups-auth. Server-only. Do not use a NEXT_PUBLIC_ name.
# SIGNUPS_SESSION_SECRET must be at least 32 characters.
# Login state (sessions, used authenticator steps, attempt counters) is stored
# in the site database by drizzle/0025_signups_admin.sql. That file is additive.
# Applying it in production needs Mark's OK before the migration is merged.
# The session cookie is httpOnly, Secure, SameSite=Strict, and path-scoped.
SIGNUPS_SESSION_SECRET=
SIGNUPS_ADMIN_PASSWORD_HASH=
SIGNUPS_TOTP_SECRET=
# Read-only token for the agentic-ai-co subscribers table (email, created_at).
# This is not the site TURSO_DATABASE_URL / TURSO_AUTH_TOKEN pair.
SIGNUPS_TURSO_DATABASE_URL=
SIGNUPS_TURSO_AUTH_TOKEN=
# Optional. Bare identifiers only. Defaults: subscribers, email, created_at.
# SIGNUPS_TURSO_TABLE=
# SIGNUPS_TURSO_EMAIL_COLUMN=
# SIGNUPS_TURSO_CREATED_COLUMN=
# Optional login failure delay in milliseconds. Default 800. Maximum 5000.
# SIGNUPS_LOGIN_FAILURE_DELAY_MS=

