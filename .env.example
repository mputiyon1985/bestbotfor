# Local SQLite. Production uses a libsql:// Turso URL plus TURSO_AUTH_TOKEN.
TURSO_DATABASE_URL=file:./data/local.db
TURSO_AUTH_TOKEN=

# Canonical origin. Production is the apex domain.
NEXT_PUBLIC_SITE_URL=https://bestbotfor.com

# Optional. Click logs store a hash only when this is set. Raw IPs are never stored.
IP_HASH_SALT=

# HMAC key for rate-limit bucket ids. Production (VERCEL_ENV=production) requires this and it must be at least 32 bytes.
# Elsewhere, when unset, a 32-byte key is derived with HKDF-SHA256 from another server secret of at least 16 characters, and a warning is logged.
# Setting or rotating it starts new windows. In-flight counters are left behind.
RATE_LIMIT_HMAC_SECRET=

# Clerk. Leave blank to run the public site without accounts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe test mode only. A live-mode key is refused at runtime and in CI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional Beehiiv. When unset, newsletter emails are stored locally.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Optional Google Analytics 4 measurement ID, for example G-XXXX.
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# User ratings. Server-only. The exact value "on" enables the feature outside production.
# Production stays off until USER_RATINGS_PRODUCTION_LAUNCH in src/lib/review-flags.ts is true.
# Leave this blank. Do not use a NEXT_PUBLIC_ name.
USER_RATINGS=

# Review IP HMAC. Required when VERCEL_ENV=production and when USER_RATINGS=on.
# At least 32 bytes. No fallback. Must differ from RATE_LIMIT_HMAC_SECRET.
# KEY_ID is required with the secret. Format: k followed by 1-9999, with no leading zero (^k[1-9][0-9]{0,3}$).
REVIEW_IP_HMAC_SECRET=
REVIEW_IP_HMAC_KEY_ID=
# Optional previous key, used while a rotation is verified. If set, at least 32 bytes.
# KEY_ID_PREVIOUS is then required, in the same format, and different from REVIEW_IP_HMAC_KEY_ID.
# A previous id without a previous secret is refused.
REVIEW_IP_HMAC_SECRET_PREVIOUS=
REVIEW_IP_HMAC_KEY_ID_PREVIOUS=

# E2E only. The build fails when this is 1 and VERCEL=1, VERCEL_ENV=production, or NODE_ENV=production.
# BBF_E2E_HOOKS=
