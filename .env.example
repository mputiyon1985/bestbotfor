# Local SQLite. Production uses a libsql:// Turso URL plus TURSO_AUTH_TOKEN.
TURSO_DATABASE_URL=file:./data/local.db
TURSO_AUTH_TOKEN=

# Canonical origin. Production is the apex domain.
NEXT_PUBLIC_SITE_URL=https://bestbotfor.com

# Optional. Not the click-log salt. A value of at least 16 characters can still be the HKDF source for rate-limit and click hashes when RATE_LIMIT_HMAC_SECRET is unset or shorter than 16 characters.
IP_HASH_SALT=

# HMAC key for rate-limit bucket ids and click-log IP hashes. Use at least 16 characters.
# A shorter value is ignored. When unset or too short, HKDF-SHA256 derives a 32-byte key from another server secret of at least 16 characters, and a warning is logged. The value is never logged.
# Setting or rotating it starts new windows and new click hashes. In-flight counters are left behind.
RATE_LIMIT_HMAC_SECRET=

# Clerk. Leave blank to run the public site without accounts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe test mode only. A live-mode key is refused at runtime and in CI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional Beehiiv. When unset, newsletter emails are stored locally.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Optional Google Analytics 4 measurement ID, for example G-XXXX.
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# User ratings. Server-only. The exact value "on" enables the feature only when
# VERCEL_ENV is preview, development, or test, or when VERCEL_ENV is unset and
# NODE_ENV is not production. Any other VERCEL_ENV is off. Production stays off
# until USER_RATINGS_PRODUCTION_LAUNCH in src/lib/review-flags.ts is true.
# Leave this blank. Do not use a NEXT_PUBLIC_ name.
USER_RATINGS=
