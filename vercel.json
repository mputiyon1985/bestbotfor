{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/data-retention",
      "schedule": "17 8 * * *"
    }
  ],
  "routes": [
    {
      "src": "^(?:.*?)(?:^|/)(?:\\.|%2[eE]|%252[eE]|%25252[eE]){1,2}(?:/|%2[fF]|%5[cC]|$).*$",
      "status": 404,
      "headers": {
        "cache-control": "no-store",
        "content-type": "text/plain; charset=utf-8",
        "x-robots-tag": "noindex, nofollow"
      }
    },
    {
      "src": "^.*%(?:$|[^0-9A-Fa-f]|[0-9A-Fa-f](?:$|[^0-9A-Fa-f])).*$",
      "status": 400,
      "headers": {
        "cache-control": "no-store",
        "content-type": "text/plain; charset=utf-8",
        "x-robots-tag": "noindex, nofollow"
      }
    },
    {
      "src": "^(/admin(?:/signups(?:/[^/]+)*)?)/{2,}$",
      "status": 308,
      "headers": {
        "Location": "$1",
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ]
}
