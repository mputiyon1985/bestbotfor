{
  "name": "bestbotfor",
  "version": "0.1.0",
  "private": true,
  "description": "Three questions. One best bot.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/prepare-db.ts && next dev",
    "prebuild": "tsx scripts/prepare-db.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
