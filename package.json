    "check:stripe-keys": "tsx scripts/check-no-live-stripe-keys.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.16",
    "@libsql/client": "^0.18.0",
    "@next/third-parties": "^16.4.1",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
